  <div class="max-w-5xl mx-auto px-4">
    <h3 class="text-xl font-semibold mb-4 text-gray-200">Documentation</h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 text-sm">
      <a href="/docs/install" class="text-blue-400 hover:underline">Installation</a>
      <a href="/docs/cli" class="text-blue-400 hover:underline">CLI Reference</a>
      <a href="/docs/security" class="text-blue-400 hover:underline">Security Model</a>
      <a href="/docs/vault" class="text-blue-400 hover:underline">Vault Lifecycle</a>
      <a href="/docs/ux" class="text-blue-400 hover:underline">UX Specification</a>
      <a href="/docs/faq" class="text-blue-400 hover:underline">FAQ</a>
      <a href="/docs/changelog" class="text-blue-400 hover:underline">Changelog</a>
    </div>
  </div>
</section>