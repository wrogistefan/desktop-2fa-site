---
const captures = [
  { file: '04-add-account', title: 'Add accounts through a form', description: 'Manual entry or a masked provisioning URI. Original TOTP parameters are preserved.' },
  { file: '05-code-expiring', title: 'See the seconds that matter', description: 'Live countdowns show when the selected account’s current code is about to expire.' },
];
---
<section id="screenshots" aria-labelledby="screenshots-heading">
  <p class="eyebrow">Inside the 0.11.0 interface</p>
  <h2 id="screenshots-heading">Less typing. More visibility.</h2>
  <div class="screenshot-grid">
    {captures.map(({ file, title, description }) => (
      <figure class="screenshot-card">
        <a href={`/screenshots/textual-ui/${file}.png`} aria-label={`Open full-size screenshot: ${title}`}>
          <img src={`/screenshots/textual-ui/${file}.png`} alt={title} width="1360" height="978" loading="lazy" decoding="async" />
        </a>
        <figcaption><h3>{title}</h3><p>{description}</p></figcaption>
      </figure>
    ))}
  </div>
  <p class="muted">Actual 0.11.0 Textual screens with synthetic accounts, captured headlessly using a controlled clock. These are rendered terminal captures, not native desktop windows.</p>
  <p><a href="https://github.com/wrogistefan/desktop-2fa/blob/v0.11.0/assets/screenshots/textual-ui/README.md">Capture methods and limitations</a> · <a href="/screenshots/textual-ui/report.json">Synthetic UI campaign report</a> · <a href="/screenshots/release-0.10.0/codes.png">CLI output example (0.10.0)</a></p>
</section>
