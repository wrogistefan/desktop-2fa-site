<!--
  Features section
-->

<section aria-labelledby="features-heading">
  <h2 id="features-heading">Features</h2>
  <div class="features-grid">
    <article class="feature">
      <h3 class="feature-title">Offline, Local-First</h3>
      <p class="feature-desc">TOTP secrets live in your local encrypted vault; there is no cloud sync.</p>
    </article>
    <article class="feature">
      <h3 class="feature-title">Encrypted Vault</h3>
      <p class="feature-desc">AES-256-GCM authenticated encryption with Argon2id password-based key derivation.</p>
    </article>
    <article class="feature">
      <h3 class="feature-title">TOTP Standards</h3>
      <p class="feature-desc">Generate RFC 6238 codes; URI-based add preserves the algorithm, digit count and time period.</p>
    </article>
    <article class="feature">
      <h3 class="feature-title">CLI and Terminal UI</h3>
      <p class="feature-desc">A full command-line interface plus an early Textual UI prototype for viewing and copying codes.</p>
    </article>
    <article class="feature">
      <h3 class="feature-title">Clipboard Options</h3>
      <p class="feature-desc">Copy generated codes with the CLI's <code>--copy</code> or <code>--copy-only</code> options.</p>
    </article>
    <article class="feature">
      <h3 class="feature-title">Configurable Vault</h3>
      <p class="feature-desc">Choose a vault with <code>--vault</code> or <code>DESKTOP_2FA_VAULT</code>; zxcvbn evaluates password strength.</p>
    </article>
  </div>
</section>