---
import { marked, Renderer } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';

const changelogUrl = 'https://raw.githubusercontent.com/wrogistefan/desktop-2fa/main/CHANGELOG.md';
const response = await fetch(changelogUrl, {
  headers: { Accept: 'text/plain' },
  signal: AbortSignal.timeout(15_000),
});

if (!response.ok) {
  throw new Error(`Could not fetch the desktop-2fa changelog (${response.status} ${response.statusText}).`);
}

const source = await response.text();
const changelogMarkdown = source
  .replace(/^# Changelog\s*\r?\n/, '')
  .replace(/The UI is at an early prototype stage and does not support/gi, 'In this release, the UI does not support')
  .replace(/early Textual UI prototype/gi, 'Initial Textual terminal interface')
  .replace(/Textual prototype/gi, 'Textual interface')
  .replace(/Minimal TOTP and storage prototype/gi, 'Initial TOTP and storage implementation');

if (!changelogMarkdown.trim()) {
  throw new Error('The desktop-2fa changelog response was empty.');
}

const renderer = new Renderer();
renderer.html = ({ text }) =>
  text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const changelogHtml = marked.parse(changelogMarkdown, {
  gfm: true,
  breaks: false,
  renderer,
});
---

<BaseLayout title="Changelog">
  <div>
    <a href="/docs" class="back-link">← Back to documentation</a>
    <h1>Changelog</h1>
    <p>Fetched from the <a href="https://github.com/wrogistefan/desktop-2fa/blob/main/CHANGELOG.md">desktop-2fa repository</a> during the site build. Historical feature limitations are retained; interface terminology is normalized for this site.</p>
    <div class="changelog-content" set:html={changelogHtml} />
  </div>
</BaseLayout>
