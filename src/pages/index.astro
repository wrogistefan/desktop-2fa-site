---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Install from '../components/Install.astro';
import Features from '../components/Features.astro';
import HowItWorks from '../components/HowItWorks.astro';
import SecurityModel from '../components/SecurityModel.astro';
import CLIExamples from '../components/CLIExamples.astro';
import WhoIsItFor from '../components/WhoIsItFor.astro';
import Comparison from '../components/Comparison.astro';
import FAQ from '../components/FAQ.astro';
import Roadmap from '../components/Roadmap.astro';
import Footer from '../components/Footer.astro';
import AfterFooterDocsLinks from "../components/AfterFooterDocsLinks.astro";
---

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>desktop‑2fa — Offline TOTP Authenticator</title>

  <meta name="description" content="Offline TOTP authenticator with AES‑256‑GCM encryption, Argon2 key derivation, deterministic builds, and no cloud dependencies.">
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Łukasz Perek" />
  <meta name="theme-color" content="#0f172a" />

  <!-- OpenGraph -->
  <meta property="og:title" content="desktop‑2fa — Offline TOTP Authenticator" />
  <meta property="og:description" content="An offline, open-source TOTP manager for developers and privacy-focused users. Local secrets, no cloud, fully auditable." />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://desktop-2fa.org/og-image.svg" />
  <meta property="og:url" content="https://desktop-2fa.org/" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="desktop‑2fa — Offline TOTP Authenticator" />
  <meta name="twitter:description" content="An offline, open-source TOTP manager for developers and privacy-focused users. Local secrets, no cloud, fully auditable." />
  <meta name="twitter:image" content="https://desktop-2fa.org/og-image.svg" />

  <!-- Canonical -->
  <link rel="canonical" href="https://desktop-2fa.org/" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "desktop-2fa",
    "applicationCategory": "SecurityApplication",
    "operatingSystem": "Windows, macOS, Linux",
    "description": "Offline TOTP authenticator with AES-256-GCM encryption, Argon2 key derivation, deterministic builds, and no cloud dependencies.",
    "url": "https://desktop-2fa.org/",
    "softwareVersion": "1.0.0",
    "license": "https://github.com/wrogistefan/desktop-2fa/blob/main/LICENSE",
    "sourceCode": "https://github.com/wrogistefan/desktop-2fa"
  }
  </script>
</head>


  <body>
    <div class="page">
      <main class="page-main">
        <Header />

        <div class="container">
          <Hero />
          <Install />
          <Features />
          <HowItWorks />
          <SecurityModel />
          <CLIExamples />
          <WhoIsItFor />
          <Comparison />
          <FAQ />
          <Roadmap />
          <Footer />
          <AfterFooterDocsLinks />
        </div>
      </main>
    </div>
  </body>
</html>